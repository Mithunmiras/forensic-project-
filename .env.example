# RetailIQ configuration. Copy to .env (never commit .env) and edit.
# Nothing here is required EXCEPT DATABASE_URL: without it the dashboard shows a setup screen
# instead of figures. Everything else has a working default.

# ---------------------------------------------------------------- database (PostgreSQL)
# REQUIRED. Privileged connection used by schema setup and the ETL only.
# Option A - your own PostgreSQL:   postgresql://postgres:YOUR_PASSWORD@localhost:5432/retailiq_db
# Option B - project-local dev DB:  run `python scripts/dev_postgres.py start` and use
#                                   postgresql://postgres@127.0.0.1:54329/retailiq_db
DATABASE_URL=

# RECOMMENDED. SELECT-only connection used by the dashboard and the natural-language SQL agent.
# Create the role with:  READONLY_DB_PASSWORD=... python scripts/setup_database.py --create-readonly-role
# If empty, DATABASE_URL is reused (still read-only per session, but no dedicated role).
DATABASE_READONLY_URL=
# Only read by scripts/setup_database.py when creating the read-only role.
READONLY_DB_PASSWORD=

QUERY_TIMEOUT_MS=8000        # statement timeout for analytics queries
MAX_RESULT_ROWS=500          # row cap for natural-language SQL results

# ---------------------------------------------------------------- API server
FRONTEND_ORIGIN=http://localhost:5173   # allowed browser origin(s), comma-separated (CORS)
# Enables the protected admin endpoints (re-index, retrain). Leave empty to disable them.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- ML model
MODEL_PATH=models/sales_model.joblib
METRICS_PATH=models/metrics.json

# ---------------------------------------------------------------- LLM (OPTIONAL - the app works without it)
# Install Ollama (https://ollama.com), then:  ollama pull llama3.2
LLM_PROVIDER=ollama          # ollama | none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_S=90
SQL_AGENT_STRATEGY=template_first   # template_first | llm_first
LLM_ROUTING=true             # let the LLM choose tools when it is available (rules are the fallback)

# ---------------------------------------------------------------- RAG / vector store
EMBEDDING_PROVIDER=auto      # auto | chroma | ollama | lexical
EMBEDDING_MODEL=nomic-embed-text   # only used when EMBEDDING_PROVIDER=ollama
VECTOR_STORE_PATH=vectorstore
RAG_SOURCES=README.md,docs/**/*.md,docs/**/*.txt
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.22
RAG_CHUNK_CHARS=600
RAG_CHUNK_OVERLAP=100

# ---------------------------------------------------------------- agent limits
AGENT_MAX_TOOL_CALLS=3
AGENT_TIME_BUDGET_S=120

# Frontend settings live in frontend/.env.example (VITE_API_BASE_URL, VITE_PROXY_TARGET).
