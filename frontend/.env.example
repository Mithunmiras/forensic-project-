# Frontend configuration (copy to .env.local). Everything here is public - never put secrets in it.

# Base URL of the RetailIQ API. Leave empty to use the same origin (the Vite dev server proxies /api,
# and the production build is served by FastAPI itself).
VITE_API_BASE_URL=

# Dev only: where the Vite proxy forwards /api. Change it if port 8000 is already in use.
VITE_PROXY_TARGET=http://127.0.0.1:8000
